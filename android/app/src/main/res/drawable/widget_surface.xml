<?xml version="1.0" encoding="utf-8"?>
<!-- PROPOSAL — replaces origin/main drawable/widget_surface.xml. RemoteViews cannot blur, so widgets
     use the saver-strength tint so text stays readable over any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="@dimen/radius_widget" /><solid android:color="#EB121B1F" /></shape></item>
    <item><shape><corners android:radius="@dimen/radius_widget" />
        <gradient android:angle="315" android:startColor="@color/glass_sheen_start" android:endColor="@color/glass_sheen_end" /></shape></item>
    <item><shape><corners android:radius="@dimen/radius_widget" /><stroke android:width="1dp" android:color="@color/glass_edge" /></shape></item>
</layer-list>
