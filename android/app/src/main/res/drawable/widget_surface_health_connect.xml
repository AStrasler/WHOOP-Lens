<?xml version="1.0" encoding="utf-8"?>
<!-- PROPOSAL. Health Connect widgets (e.g. Steps) get a dashed edge, matching the in-app chip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="@dimen/radius_widget" /><solid android:color="#EB121B1F" /></shape></item>
    <item><shape><corners android:radius="@dimen/radius_widget" /><stroke android:width="1dp" android:color="#8CF2DDB2" android:dashWidth="5dp" android:dashGap="4dp" /></shape></item>
</layer-list>
