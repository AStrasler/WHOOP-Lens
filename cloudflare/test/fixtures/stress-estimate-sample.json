    "z_clip": 3,
    "artifact_z": 8,
    "plausible_ranges": {
      "hrv_rmssd": [
        5,
        300
      ],
      "resting_heart_rate": [
        25,
        130
      ],
      "sleep_performance": [
        0,
        100
      ],
      "sleep_duration": [
        0.5,
        16
      ],
      "sleep_efficiency": [
        0,
        100
      ],
      "respiratory_rate": [
        5,
        40
      ]
    },
    "confidence": "sum of scored effective weights x each input's baseline completeness (n/30), x (1 - 0.15 per conflict); conflicts are disagreeing or unsupported capped inputs, suspected artifacts and implausible values",
    "clusters": {
      "autonomic": 0.6,
      "sleep": 0.3,
      "respiratory": 0.1
    },
    "inputs": {
      "hrv_rmssd": {
        "label": "HRV (RMSSD)",
        "unit": "millisecond",
        "direction": "lower_is_more_load",
        "cluster": "autonomic",
        "weight_in_cluster": 0.6
      },
      "resting_heart_rate": {
        "label": "Resting heart rate",
        "unit": "bpm",
        "direction": "higher_is_more_load",
        "cluster": "autonomic",
        "weight_in_cluster": 0.4
      },
      "sleep_performance": {
        "label": "Sleep performance",
        "unit": "percent",
        "direction": "lower_is_more_load",
        "cluster": "sleep",
        "weight_in_cluster": 0.4
      },
      "sleep_duration": {
        "label": "Sleep duration",
        "unit": "hour",
        "direction": "lower_is_more_load",
        "cluster": "sleep",
        "weight_in_cluster": 0.35
      },
      "sleep_efficiency": {
        "label": "Sleep efficiency",
        "unit": "percent",
        "direction": "lower_is_more_load",
        "cluster": "sleep",
        "weight_in_cluster": 0.25
      },
      "respiratory_rate": {
        "label": "Respiratory rate",
        "unit": "breaths per minute",
        "direction": "higher_is_more_load",
        "cluster": "respiratory",
        "weight_in_cluster": 1
      }
    },
    "excluded": {
      "recovery_score": "WHOOP recovery is derived largely from HRV, resting heart rate and sleep, so scoring it would double count those inputs.",
      "skin_temp": "WHOOP skin temperature has no single stress direction (it can move either way), so it is not scored."
    },
    "bands": [
      {
        "band": "low",
        "max": 35
      },
      {
        "band": "typical",
        "max": 65
      },
      {
        "band": "elevated",
        "max": 80
      },
      {
        "band": "high",
        "max": 100
      }
    ],
    "sleep_join": "recovery.sleep_id = sleep.id",
    "sleep_data": "included"
  },
