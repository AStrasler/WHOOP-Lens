{
  "metric": "stress_estimate",
  "name": "WHOOP Lens experimental physiological stress estimate",
  "label": "Experimental WHOOP Lens estimate. Not WHOOP's Stress Monitor. Not clinically validated. Not a diagnosis.",
  "experimental": true,
  "version": "wl-stress-v1",
  "unit": "index",
  "scale": {
    "min": 0,
    "max": 100,
    "personal_typical": 50
  },
  "available": true,
  "reason": null,
  "date_range": {
    "start": "2026-10-06",
    "end": "2026-10-15"
  },
  "method": {
    "baseline_days": 30,
    "min_baseline_days": 14,
    "center": "median",
    "spread": "MAD x 1.4826",
    "z_clip": 3,
    "clusters": {
      "autonomic": 0.6,
      "sleep": 0.3,
      "respiratory": 0.1
    },
    "inputs": {
      "hrv_rmssd": {
        "label": "HRV (RMSSD)",
        "unit": "millisecond",
        "direction": "lower_is_more_load",
        "cluster": "autonomic",
        "weight_in_cluster": 0.6
      },
      "resting_heart_rate": {
        "label": "Resting heart rate",
        "unit": "bpm",
        "direction": "higher_is_more_load",
        "cluster": "autonomic",
        "weight_in_cluster": 0.4
      },
      "sleep_performance": {
        "label": "Sleep performance",
        "unit": "percent",
        "direction": "lower_is_more_load",
        "cluster": "sleep",
        "weight_in_cluster": 0.4
      },
      "sleep_duration": {
        "label": "Sleep duration",
        "unit": "hour",
        "direction": "lower_is_more_load",
        "cluster": "sleep",
        "weight_in_cluster": 0.35
      },
      "sleep_efficiency": {
        "label": "Sleep efficiency",
        "unit": "percent",
        "direction": "lower_is_more_load",
        "cluster": "sleep",
        "weight_in_cluster": 0.25
      },
      "respiratory_rate": {
        "label": "Respiratory rate",
        "unit": "breaths per minute",
        "direction": "higher_is_more_load",
        "cluster": "respiratory",
        "weight_in_cluster": 1
      }
    },
    "excluded": {
      "recovery_score": "WHOOP recovery is derived largely from HRV, resting heart rate and sleep, so scoring it would double count those inputs.",
      "skin_temp": "WHOOP skin temperature has no single stress direction (it can move either way), so it is not scored."
    },
    "bands": [
      {
        "band": "low",
        "max": 35
      },
      {
        "band": "typical",
        "max": 65
      },
      {
        "band": "elevated",
        "max": 80
      },
      {
        "band": "high",
        "max": 100
      }
    ],
    "sleep_join": "recovery.sleep_id = sleep.id",
    "sleep_data": "included"
  },
  "excluded_days": 0,
