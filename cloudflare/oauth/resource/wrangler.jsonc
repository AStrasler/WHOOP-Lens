{
  // Alternate future MCP resource-server build. Existing Supabase remains primary.
  "name": "whoop-lens",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "OAUTH_RESOURCE_ENABLED": "false",
    "MIGRATION_API_ENABLED": "false",
    "WHOOP_READS_ENABLED": "false",
    "WHOOP_OAUTH_ENABLED": "false",
    "MCP_ENABLED": "false",
    "WEB_HEALTH_IMPORT_ENABLED": "false",
    "HEALTH_CONNECT_WEBHOOK_ENABLED": "false",
    "AI_SUMMARY_ENABLED": "false",
    "STRESS_ESTIMATE_ENABLED": "false",
    "WHOOP_REDIRECT_URI": "https://whooplens.tech/api/whoop/callback"
  },
  "ai": { "binding": "AI" },
  "services": [{"binding":"AUTH_SERVER","service":"whoop-lens-auth"}],
  "d1_databases": [{
    "binding":"DB","database_name":"whoop-lens-migration",
    "database_id":"58250de2-cad7-4a8a-a061-d9b41c7b24d2"
  }]
}
