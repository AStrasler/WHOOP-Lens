  "vars": { "MIGRATION_API_ENABLED": "false", "WHOOP_READS_ENABLED": "false", "WHOOP_OAUTH_ENABLED": "false", "MCP_ENABLED": "false", "WEB_HEALTH_IMPORT_ENABLED": "false", "HEALTH_CONNECT_WEBHOOK_ENABLED": "false", "AI_SUMMARY_ENABLED": "false", "STRESS_ESTIMATE_ENABLED": "false", "WEEKLY_DIGEST_ENABLED": "false", "FLARE_JOURNAL_ENABLED": "false" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whoop-lens-migration",
      "database_id": "58250de2-cad7-4a8a-a061-d9b41c7b24d2",
      "migrations_dir": "migrations"
    }
  ]
