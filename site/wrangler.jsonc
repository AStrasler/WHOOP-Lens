{
  // Static WHOOP Lens public site for https://www.whooplens.tech.
  // Assets only: no Worker script, bindings, or secrets. Build first: node site/build.mjs
  "name": "whoop-lens-site",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
